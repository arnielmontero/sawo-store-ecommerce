# Server
PORT=4000
WEB_ORIGIN=http://localhost:3000
WEBSHOP_ORIGIN=http://localhost:3001

# MySQL (matches compose.yml)
DATABASE_URL="mysql://ecommerce:ecommerce@localhost:33061/ecommerce"

# Token signing secrets — change before deploying anywhere
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
REFRESH_TOKEN_SECRET="change-me-to-a-different-long-random-string"

# Stripe (test mode) and EasyPost (test mode) keys below are optional here —
# all three can instead (or additionally) be set from the admin UI at
# Configuration > Sandbox API credentials, which takes priority over these
# and applies immediately without a restart. Leave these unset if you'd
# rather configure them that way.

# Stripe — get real keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="replace-with-your-stripe-test-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-your-stripe-webhook-signing-secret"

# EasyPost — carrier tracking for Deliveries. Free sandbox key from
# https://www.easypost.com/ (a "test" key, starts with EZTK...). Leave unset
# to run without live tracking (carrier assignment still works).
EASYPOST_API_KEY="replace-with-your-easypost-test-api-key"
