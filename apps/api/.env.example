# Server
PORT=4000
WEB_ORIGIN=http://localhost:3000

# MySQL (matches compose.yml)
DATABASE_URL="mysql://ecommerce:ecommerce@localhost:33061/ecommerce"

# Token signing secrets — change before deploying anywhere
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
REFRESH_TOKEN_SECRET="change-me-to-a-different-long-random-string"

# Stripe (test mode) — get real keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="replace-with-your-stripe-test-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-your-stripe-webhook-signing-secret"
