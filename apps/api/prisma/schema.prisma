generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Admin (backoffice) access — separate from customer Users below ───────

enum AdminRole {
  ADMIN
  FULFILLMENT_STAFF
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())

  refreshTokens AdminRefreshToken[]
}

// One row per issued refresh token, so a single session can be revoked
// (logout) without invalidating every other device/session for the user.
// tokenHash stores a SHA-256 hash, never the raw token.
model AdminRefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

// ── Customer (storefront) access ──────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())

  orders Order[]
}

enum UserRole {
  CUSTOMER
}

// ── Catalog ────────────────────────────────────────────────────────────

model Category {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products Product[]
}

// Free-form labels a product can carry in addition to its single Category —
// many-to-many via ProductTag, so a product can carry several (e.g.
// "summer", "bestseller") independent of its one required category.
model Tag {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products ProductTag[]
}

model ProductTag {
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Product {
  id                  Int       @id @default(autoincrement())
  title               String
  slug                String    @unique
  description         String?   @db.Text
  basePriceCents      Int
  // Optional "was" price shown struck through next to basePriceCents to
  // present a sale (e.g. compareAtPriceCents: 5000, basePriceCents: 3500 ->
  // "$50 $35"). Null means the product isn't on sale.
  compareAtPriceCents Int?
  // Optional promo window for the compareAtPriceCents deal — when set, the
  // sale is only "active" (isOnSale true, badge shown) between these two
  // instants; both null means the sale runs indefinitely as long as
  // compareAtPriceCents is set. Lets an admin schedule a deal in advance and
  // have it expire on its own without a cron job (checked at read time).
  saleStartsAt        DateTime?
  saleEndsAt          DateTime?
  currency            String    @default("usd")
  // Deprecated in favor of ProductImage (a product can have a gallery now),
  // kept only so existing rows/callers that set a single imageUrl still
  // resolve to something — new code should read images[] instead.
  imageUrl            String?
  metaTitle           String?
  metaDescription     String?   @db.Text
  // Manual admin ordering for the catalog list (drag-to-reorder) — lower
  // sorts first. Defaults to 0 so existing products don't need a backfill
  // to keep their relative order stable (falls back to createdAt).
  sortOrder           Int       @default(0)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]
  images   ProductImage[]
  tags     ProductTag[]

  @@index([isActive])
  @@index([categoryId])
}

// A product's image gallery — replaces the old single Product.imageUrl for
// new writes. position controls display order; isFeatured marks the one
// shown in list views/thumbnails (exactly one should be featured per
// product, enforced at the service layer rather than the DB).
model ProductImage {
  id         Int     @id @default(autoincrement())
  url        String
  position   Int     @default(0)
  isFeatured Boolean @default(false)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                  Int       @id @default(autoincrement())
  sku                 String    @unique
  priceCents          Int
  // Flexible per-variant traits (size, color, etc.) that vary by product
  // type — a JSON column avoids a rigid schema for every possible attribute.
  attributes          Json?
  // Optional per-variant override image (e.g. the red variant shows a red
  // photo) — falls back to the product's featured image when null.
  imageUrl            String?
  // Per-variant sale — same shape/semantics as Product.compareAtPriceCents
  // and its date window, but scoped to just this variant so a promo can
  // target e.g. only the Bronze tint instead of every variant under the
  // product. Independent of Product.compareAtPriceCents: either or both can
  // be set; the product is considered "on sale" if it or any of its
  // (visible) variants has an active deal.
  compareAtPriceCents Int?
  saleStartsAt        DateTime?
  saleEndsAt          DateTime?
  // Soft-delete for a single variant (e.g. discontinuing one color/size
  // while keeping the rest of the product live) — same pattern as
  // Product.isActive, never a hard delete since past OrderItems reference
  // this row. A variant hidden here disappears from storefront reads even
  // when the parent product is active; the admin still sees it (greyed out)
  // so it can be reactivated or its stock reviewed.
  isActive            Boolean   @default(true)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventory        Inventory?
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]

  @@index([productId])
}

// Kept as its own table (not just a column on ProductVariant) so stock
// reservation during checkout can be locked/updated independently of the
// variant's descriptive data.
model Inventory {
  variantId        Int            @id
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockQuantity    Int            @default(0)
  reservedQuantity Int            @default(0)
}

// Every reason stockQuantity can change — mirrors the code paths that
// actually mutate it in inventory.service.ts, so this table is a complete
// "why is this at N now" history, not just a log of manual edits.
enum StockAdjustmentReason {
  MANUAL // An admin typed a new quantity into the Inventory page.
  ORDER_SALE // commitReservedStock — an order was marked PAID.
  ORDER_RETURN // restockCommittedStock — an order reached RETURNED/REFUNDED.
  REFUND_RESTOCK // restockCommittedStock via a partial refund's specific item list.
}

// One row per stockQuantity change. deltaQuantity is signed (positive =
// stock added, negative = stock removed) so the whole history can be summed
// to reconstruct stock at any point in time; resultingQuantity is stored
// too so a single row is readable on its own without replaying the sum.
model StockAdjustment {
  id                Int                   @id @default(autoincrement())
  variant           ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId         Int
  reason            StockAdjustmentReason
  deltaQuantity     Int
  resultingQuantity Int
  note              String?
  // Set only for MANUAL adjustments — who typed the new number in. Kept as
  // a plain string snapshot (like OrderNote.authorName) rather than a hard
  // FK, so a past adjustment stays legible even if that admin account is
  // later removed.
  adminName         String?
  // Set only for the order-driven reasons (ORDER_SALE/ORDER_RETURN/
  // REFUND_RESTOCK) — lets the history link back to the order that caused
  // it. Not a hard FK: an order can be hard-deleted (see
  // dataReset.service.ts's "Clear all data") without needing to cascade
  // through every stock adjustment it ever caused.
  orderId           Int?
  orderReference    String?
  createdAt         DateTime              @default(now())

  @@index([variantId])
  @@index([orderId])
}

// ── Orders ─────────────────────────────────────────────────────────────

// Strict, unidirectional state machine — see lib/orderStateMachine.ts for
// the allowed-transitions table. PENDING is the only entry state; every
// other state is reached by exactly one kind of transition (payment
// success/failure, fulfillment, delivery, cancellation/refund/return).
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
  // A refund for less than the full remaining balance was issued — the
  // order stays "open" (not terminal) so another partial refund, or a
  // final refund that closes out the remaining balance, can still happen.
  // Only reachable when StoreSettings.allowPartialRefunds is on.
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  PAY_WITH_CHECK
  PAYPAL
  BANK
  CARD
}

model Order {
  id            Int            @id @default(autoincrement())
  reference     String
  status        OrderStatus    @default(PENDING)
  // Null until checkout completes with a chosen payment method — an order
  // exists in PENDING before payment happens (see diagram: checkout locks
  // prices/stock and creates a PENDING order; a webhook later confirms
  // payment and moves it to PAID).
  paymentMethod PaymentMethod?

  subtotalCents Int
  discountCents Int    @default(0)
  shippingCents Int    @default(0)
  taxCents      Int    @default(0)
  totalCents    Int
  currency      String @default("usd")

  shippingAddress String? @db.Text
  isNewClient     Boolean @default(false)
  trackingNumber  String?

  // Payment/idempotency — paymentAttemptCount increments on every call to
  // POST /payments/intent for this order, and the value at call time forms
  // half of the idempotency key (orderId-attemptCount) passed to Stripe, so
  // a network retry of the same attempt reuses the same PaymentIntent
  // instead of creating a duplicate charge.
  paymentAttemptCount   Int     @default(0)
  stripePaymentIntentId String? @unique

  // Running total refunded so far across every RefundRecord for this order —
  // caps how much more can still be refunded (totalCents - refundedCents).
  // Stays 0 for a full refund done the old way (status flips straight to
  // REFUNDED); only meaningfully tracked once partial refunds are in play.
  refundedCents Int @default(0)

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory  OrderStatusHistory[]
  refunds        RefundRecord[]
  notes          OrderNote[]
  returnRequests ReturnRequest[]

  @@index([status])
  @@index([userId])
}

// One row per refund event (full or partial) — the audit trail for "how
// much has been refunded, and which specific item quantities were restocked
// as a result." A full refund (existing flow) also creates exactly one of
// these, covering the whole order's items, so the history reads the same
// way regardless of whether partial refunds are enabled.
model RefundRecord {
  id             Int      @id @default(autoincrement())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        Int
  amountCents    Int
  stripeRefundId String?
  createdAt      DateTime @default(now())

  items         RefundRecordItem[]
  returnRequest ReturnRequest?

  @@index([orderId])
}

// Which variant/quantity was restocked as part of a given refund — lets a
// partial refund restock only the units actually being returned, and keeps
// a running "already restocked via refund" count per item so the same units
// can never be double-restocked across multiple partial refunds.
model RefundRecordItem {
  id             Int          @id @default(autoincrement())
  refundRecord   RefundRecord @relation(fields: [refundRecordId], references: [id], onDelete: Cascade)
  refundRecordId Int
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId    Int
  quantity       Int

  @@index([refundRecordId])
  @@index([orderItemId])
}

// Free-text internal notes staff leave on an order (e.g. "customer called,
// wants address changed") — never shown to the customer, purely a backoffice
// record. Author kept as a plain string snapshot of the admin's name rather
// than a hard FK, so a note stays legible even if that admin account is
// later removed.
model OrderNote {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  body       String   @db.Text
  authorName String
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// A customer asking to return/refund items is its own step BEFORE any money
// or stock moves — distinct from RefundRecord, which only ever represents a
// refund that has actually happened. There's no live customer session in
// this system yet (see checkout()), so a request is logged by staff on the
// customer's behalf (phone/email), not submitted directly by the customer.
enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReturnRequest {
  id           Int                 @id @default(autoincrement())
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      Int
  status       ReturnRequestStatus @default(PENDING)
  // Why the customer wants to return/refund — required, shown throughout
  // the review flow so an admin never has to go dig it up from elsewhere.
  reason       String              @db.Text
  // Snapshot of who logged it and when — same pattern as OrderNote, kept
  // as plain strings rather than hard FKs so the record stays legible if
  // that admin account is later removed.
  loggedByName String
  createdAt    DateTime            @default(now())

  // Set once an ADMIN reviews the request — resolvedByName is null while
  // PENDING. reviewNote captures why it was rejected, or any context on
  // approval (e.g. "approved, see refund RE-...").
  resolvedByName String?
  resolvedAt     DateTime?
  reviewNote     String?   @db.Text

  // Only set once approval actually triggers a real refund (see
  // returnRequest.service.ts) — links the request to the RefundRecord it
  // produced, so "what happened as a result of this request" is a straight
  // lookup instead of matching timestamps.
  refundRecord   RefundRecord? @relation(fields: [refundRecordId], references: [id])
  refundRecordId Int?          @unique

  items ReturnRequestItem[]

  @@index([orderId])
  @@index([status])
}

// Which order item/quantity the customer wants to return — mirrors
// RefundRecordItem's shape (variant-level quantity, not just a dollar
// amount) so an approved request can hand its exact items straight to the
// existing partial-refund restock logic.
model ReturnRequestItem {
  id              Int           @id @default(autoincrement())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnRequestId Int
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId     Int
  quantity        Int

  @@index([returnRequestId])
  @@index([orderItemId])
}

// One row per status transition — Order.updatedAt only ever reflects the
// MOST RECENT change, so once an order has gone PENDING -> PAID -> SHIPPED,
// there's no other way to answer "when was this paid?" once it's shipped.
// This table is the real timeline shown on the order detail page.
model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  status    OrderStatus
  changedAt DateTime    @default(now())

  @@index([orderId])
}

model OrderItem {
  id             Int            @id @default(autoincrement())
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        Int
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  variantId      Int
  quantity       Int
  unitPriceCents Int

  refundItems        RefundRecordItem[]
  returnRequestItems ReturnRequestItem[]

  @@index([orderId])
  @@index([variantId])
}

// ── Payments ───────────────────────────────────────────────────────────

// Webhook replay protection — no Redis in this stack, so processed Stripe
// event IDs are recorded here instead. A webhook whose event.id already
// exists is ignored rather than reprocessed, since Stripe can and does
// redeliver the same event.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event.id
  type        String
  processedAt DateTime @default(now())
}

// ── Store settings ─────────────────────────────────────────────────────

// Singleton row (always id: 1) for store-wide admin-configurable values —
// the Configuration page reads/writes this. Starts with just the store
// name (shown in the Sidebar instead of a hardcoded string); add more
// columns here as Configuration grows rather than one-off hardcoded values
// elsewhere in the UI.
model StoreSettings {
  id                  Int      @id @default(1)
  storeName           String   @default("Sawo Shop")
  // Null means "no logo uploaded" — the Sidebar falls back to a plain
  // initial-letter box in that case rather than a broken image.
  logoUrl             String?
  // Off by default — partial refunds leave an order in an in-between
  // PARTIALLY_REFUNDED state with specific items/quantities held out of
  // inventory, which is a real operational mode staff need to opt into
  // rather than have silently available. See payment.service.ts refundOrder.
  allowPartialRefunds Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}
