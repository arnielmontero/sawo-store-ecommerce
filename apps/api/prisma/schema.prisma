generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Admin (backoffice) access — separate from customer Users below ───────

enum AdminRole {
  ADMIN
  // Day-to-day store operations — catalog, inventory, coupons, customers,
  // reviews/Q&A, refunds, carrier/payment rules. Everything ADMIN can do
  // EXCEPT the three most sensitive areas: Staff accounts (see
  // staff.routes.ts), Configuration/API credentials (settings.routes.ts),
  // and Tax rules (taxRules.routes.ts) — those stay ADMIN-only so a Manager
  // can run the store but can't touch who has access, external API keys, or
  // the store's tax liability.
  MANAGER
  FULFILLMENT_STAFF
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())

  refreshTokens AdminRefreshToken[]
}

// One row per issued refresh token, so a single session can be revoked
// (logout) without invalidating every other device/session for the user.
// tokenHash stores a SHA-256 hash, never the raw token.
model AdminRefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

// ── Customer (storefront) access ──────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())

  // Contact/profile fields — all optional since there's no storefront
  // signup flow in this system yet (see checkout()); staff fill these in
  // from the Customer detail page as they learn them (phone call, support
  // ticket, etc.), same "captured over time by staff" reasoning as
  // OrderNote/ReturnRequest. addressLine1/2 mirror Order.shippingAddress's
  // level of detail but as structured fields (that one stays a free-text
  // snapshot per-order — this is the customer's standing contact info).
  name         String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  orders    Order[]
  reviews   Review[]
  questions ProductQuestion[]
  cartLeads CartLead[]
}

enum UserRole {
  CUSTOMER
}

// ── Catalog ────────────────────────────────────────────────────────────

model Category {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  // Optional parent for a two-level nav (e.g. "Sauna Accessories" ->
  // "Pails"/"Ladles") — self-relation so the storefront can render nested
  // category groups. Null means top-level. Not restricted to two levels at
  // the DB layer, but every current caller only walks one level down.
  parentId Int?
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  products Product[]

  @@index([parentId])
}

// Free-form labels a product can carry in addition to its single Category —
// many-to-many via ProductTag, so a product can carry several (e.g.
// "summer", "bestseller") independent of its one required category.
model Tag {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products ProductTag[]
}

model ProductTag {
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Product {
  id                  Int       @id @default(autoincrement())
  title               String
  slug                String    @unique
  description         String?   @db.Text
  basePriceCents      Int
  // Optional "was" price shown struck through next to basePriceCents to
  // present a sale (e.g. compareAtPriceCents: 5000, basePriceCents: 3500 ->
  // "$50 $35"). Null means the product isn't on sale.
  compareAtPriceCents Int?
  // Optional promo window for the compareAtPriceCents deal — when set, the
  // sale is only "active" (isOnSale true, badge shown) between these two
  // instants; both null means the sale runs indefinitely as long as
  // compareAtPriceCents is set. Lets an admin schedule a deal in advance and
  // have it expire on its own without a cron job (checked at read time).
  saleStartsAt        DateTime?
  saleEndsAt          DateTime?
  currency            String    @default("usd")
  // Deprecated in favor of ProductImage (a product can have a gallery now),
  // kept only so existing rows/callers that set a single imageUrl still
  // resolve to something — new code should read images[] instead.
  imageUrl            String?
  metaTitle           String?
  metaDescription     String?   @db.Text
  // Manual admin ordering for the catalog list (drag-to-reorder) — lower
  // sorts first. Defaults to 0 so existing products don't need a backfill
  // to keep their relative order stable (falls back to createdAt).
  sortOrder           Int       @default(0)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  variants  ProductVariant[]
  images    ProductImage[]
  tags      ProductTag[]
  reviews   Review[]
  questions ProductQuestion[]

  @@index([isActive])
  @@index([categoryId])
}

// A product's image gallery — replaces the old single Product.imageUrl for
// new writes. position controls display order; isFeatured marks the one
// shown in list views/thumbnails (exactly one should be featured per
// product, enforced at the service layer rather than the DB).
model ProductImage {
  id         Int     @id @default(autoincrement())
  url        String
  position   Int     @default(0)
  isFeatured Boolean @default(false)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                  Int       @id @default(autoincrement())
  sku                 String    @unique
  priceCents          Int
  // Flexible per-variant traits (size, color, etc.) that vary by product
  // type — a JSON column avoids a rigid schema for every possible attribute.
  attributes          Json?
  // Optional per-variant override image (e.g. the red variant shows a red
  // photo) — falls back to the product's featured image when null.
  imageUrl            String?
  // Per-variant sale — same shape/semantics as Product.compareAtPriceCents
  // and its date window, but scoped to just this variant so a promo can
  // target e.g. only the Bronze tint instead of every variant under the
  // product. Independent of Product.compareAtPriceCents: either or both can
  // be set; the product is considered "on sale" if it or any of its
  // (visible) variants has an active deal.
  compareAtPriceCents Int?
  saleStartsAt        DateTime?
  saleEndsAt          DateTime?
  // Soft-delete for a single variant (e.g. discontinuing one color/size
  // while keeping the rest of the product live) — same pattern as
  // Product.isActive, never a hard delete since past OrderItems reference
  // this row. A variant hidden here disappears from storefront reads even
  // when the parent product is active; the admin still sees it (greyed out)
  // so it can be reactivated or its stock reviewed.
  isActive            Boolean   @default(true)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventory        Inventory?
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]
  cartLeadItems    CartLeadItem[]

  @@index([productId])
}

// Kept as its own table (not just a column on ProductVariant) so stock
// reservation during checkout can be locked/updated independently of the
// variant's descriptive data.
model Inventory {
  variantId        Int            @id
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockQuantity    Int            @default(0)
  reservedQuantity Int            @default(0)
}

// Every reason stockQuantity can change — mirrors the code paths that
// actually mutate it in inventory.service.ts, so this table is a complete
// "why is this at N now" history, not just a log of manual edits.
enum StockAdjustmentReason {
  MANUAL // An admin typed a new quantity into the Inventory page.
  ORDER_SALE // commitReservedStock — an order was marked PAID.
  ORDER_RETURN // restockCommittedStock — an order reached RETURNED/REFUNDED.
  REFUND_RESTOCK // restockCommittedStock via a partial refund's specific item list.
}

// One row per stockQuantity change. deltaQuantity is signed (positive =
// stock added, negative = stock removed) so the whole history can be summed
// to reconstruct stock at any point in time; resultingQuantity is stored
// too so a single row is readable on its own without replaying the sum.
model StockAdjustment {
  id                Int                   @id @default(autoincrement())
  variant           ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId         Int
  reason            StockAdjustmentReason
  deltaQuantity     Int
  resultingQuantity Int
  note              String?
  // Set only for MANUAL adjustments — who typed the new number in. Kept as
  // a plain string snapshot (like OrderNote.authorName) rather than a hard
  // FK, so a past adjustment stays legible even if that admin account is
  // later removed.
  adminName         String?
  // Set only for the order-driven reasons (ORDER_SALE/ORDER_RETURN/
  // REFUND_RESTOCK) — lets the history link back to the order that caused
  // it. Not a hard FK: an order can be hard-deleted (see
  // dataReset.service.ts's "Clear all data") without needing to cascade
  // through every stock adjustment it ever caused.
  orderId           Int?
  orderReference    String?
  createdAt         DateTime              @default(now())

  @@index([variantId])
  @@index([orderId])
}

// ── Orders ─────────────────────────────────────────────────────────────

// Strict, unidirectional state machine — see lib/orderStateMachine.ts for
// the allowed-transitions table. PENDING is the only entry state; every
// other state is reached by exactly one kind of transition (payment
// success/failure, fulfillment, delivery, cancellation/refund/return).
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURNED
  // A refund for less than the full remaining balance was issued — the
  // order stays "open" (not terminal) so another partial refund, or a
  // final refund that closes out the remaining balance, can still happen.
  // Only reachable when StoreSettings.allowPartialRefunds is on.
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  PAY_WITH_CHECK
  PAYPAL
  BANK
  CARD
}

model Order {
  id            Int            @id @default(autoincrement())
  reference     String
  status        OrderStatus    @default(PENDING)
  // Null until checkout completes with a chosen payment method — an order
  // exists in PENDING before payment happens (see diagram: checkout locks
  // prices/stock and creates a PENDING order; a webhook later confirms
  // payment and moves it to PAID).
  paymentMethod PaymentMethod?

  subtotalCents Int
  discountCents Int    @default(0)
  shippingCents Int    @default(0)
  taxCents      Int    @default(0)
  totalCents    Int
  currency      String @default("usd")

  shippingAddress String? @db.Text
  // ISO 3166-1 alpha-2 country code (e.g. "US", "DE") — kept as a separate
  // structured field alongside the free-text shippingAddress specifically
  // so carrier assignment (see CarrierRule) can match on it directly rather
  // than parsing the address blob.
  shippingCountry String?
  isNewClient     Boolean @default(false)
  trackingNumber  String?
  // Carrier code (e.g. "UPS", "DHL") — auto-assigned at checkout from
  // CarrierRule based on shippingCountry, but a human can still override it
  // per-order from the Deliveries page before shipping.
  carrier         String?

  // EasyPost tracker (test mode) created when the order is marked shipped —
  // see shipping.service.ts. Null until then; deliveryStatus is refreshed
  // from EasyPost's own tracker.status on each Deliveries page load.
  easypostTrackerId   String?
  easypostTrackingUrl String?
  deliveryStatus      String?

  // Payment/idempotency — paymentAttemptCount increments on every call to
  // POST /payments/intent for this order, and the value at call time forms
  // half of the idempotency key (orderId-attemptCount) passed to Stripe, so
  // a network retry of the same attempt reuses the same PaymentIntent
  // instead of creating a duplicate charge.
  paymentAttemptCount   Int     @default(0)
  stripePaymentIntentId String? @unique

  // Card metadata Stripe itself provides on a successful charge — never raw
  // card numbers (PCI scope never touches this app, see payment.service.ts's
  // handleStripeWebhook). Populated from the expanded PaymentIntent's
  // payment_method on payment_intent.succeeded; stays null for orders that
  // never reached a real Stripe charge (PENDING/CANCELLED, or seeded demo
  // orders with a fake stripePaymentIntentId).
  cardBrand          String?
  cardLast4          String?
  paymentStatus      String? // Stripe's own PaymentIntent.status string (e.g. "succeeded") — a snapshot, not re-derived from our OrderStatus.
  paymentDeclineCode String? // Set only if a payment_intent.payment_failed carried a decline/error code.

  // Running total refunded so far across every RefundRecord for this order —
  // caps how much more can still be refunded (totalCents - refundedCents).
  // Stays 0 for a full refund done the old way (status flips straight to
  // REFUNDED); only meaningfully tracked once partial refunds are in play.
  refundedCents Int @default(0)

  // Nullable - most orders have no coupon. Kept as a real FK (unlike
  // OrderNote.authorName-style snapshots) because a coupon is reference
  // data an admin may legitimately want to query "orders that used X" from,
  // and coupons are cheap to keep around (soft-deactivate via isActive
  // rather than hard delete). couponCode is still snapshotted as a plain
  // string alongside the FK so the order stays legible (shows "SAVE10" on
  // the receipt/detail page) even in the edge case a coupon row is later
  // hard-deleted; the FK uses onDelete: SetNull for that same reason - a
  // deleted coupon must never cascade-delete or orphan historical orders.
  couponId   Int?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  items OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // First time this order's status transitioned to PAID — set once inside
  // setOrderStatus and never overwritten afterward. Deliberately distinct
  // from updatedAt, which bumps on ANY field write (a staff note, a refund)
  // and would silently reset a "how long paid but unshipped" clock if used
  // for that instead — see shipping.service.ts's overdue calculation.
  paidAt    DateTime?

  statusHistory  OrderStatusHistory[]
  refunds        RefundRecord[]
  notes          OrderNote[]
  returnRequests ReturnRequest[]

  @@index([status])
  @@index([userId])
  @@index([status, paidAt])
  @@index([couponId])
}

// One row per refund event (full or partial) — the audit trail for "how
// much has been refunded, and which specific item quantities were restocked
// as a result." A full refund (existing flow) also creates exactly one of
// these, covering the whole order's items, so the history reads the same
// way regardless of whether partial refunds are enabled.
model RefundRecord {
  id             Int      @id @default(autoincrement())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        Int
  amountCents    Int
  stripeRefundId String?
  createdAt      DateTime @default(now())

  items         RefundRecordItem[]
  returnRequest ReturnRequest?

  @@index([orderId])
}

// Which variant/quantity was restocked as part of a given refund — lets a
// partial refund restock only the units actually being returned, and keeps
// a running "already restocked via refund" count per item so the same units
// can never be double-restocked across multiple partial refunds.
model RefundRecordItem {
  id             Int          @id @default(autoincrement())
  refundRecord   RefundRecord @relation(fields: [refundRecordId], references: [id], onDelete: Cascade)
  refundRecordId Int
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId    Int
  quantity       Int

  @@index([refundRecordId])
  @@index([orderItemId])
}

// Free-text internal notes staff leave on an order (e.g. "customer called,
// wants address changed") — never shown to the customer, purely a backoffice
// record. Author kept as a plain string snapshot of the admin's name rather
// than a hard FK, so a note stays legible even if that admin account is
// later removed.
model OrderNote {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  body       String   @db.Text
  authorName String
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// A customer asking to return/refund items is its own step BEFORE any money
// or stock moves — distinct from RefundRecord, which only ever represents a
// refund that has actually happened. There's no live customer session in
// this system yet (see checkout()), so a request is logged by staff on the
// customer's behalf (phone/email), not submitted directly by the customer.
enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReturnRequest {
  id           Int                 @id @default(autoincrement())
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      Int
  status       ReturnRequestStatus @default(PENDING)
  // Why the customer wants to return/refund — required, shown throughout
  // the review flow so an admin never has to go dig it up from elsewhere.
  reason       String              @db.Text
  // Snapshot of who logged it and when — same pattern as OrderNote, kept
  // as plain strings rather than hard FKs so the record stays legible if
  // that admin account is later removed.
  loggedByName String
  createdAt    DateTime            @default(now())

  // Set once an ADMIN reviews the request — resolvedByName is null while
  // PENDING. reviewNote captures why it was rejected, or any context on
  // approval (e.g. "approved, see refund RE-...").
  resolvedByName String?
  resolvedAt     DateTime?
  reviewNote     String?   @db.Text

  // Only set once approval actually triggers a real refund (see
  // returnRequest.service.ts) — links the request to the RefundRecord it
  // produced, so "what happened as a result of this request" is a straight
  // lookup instead of matching timestamps.
  refundRecord   RefundRecord? @relation(fields: [refundRecordId], references: [id])
  refundRecordId Int?          @unique

  items ReturnRequestItem[]

  @@index([orderId])
  @@index([status])
}

// Which order item/quantity the customer wants to return — mirrors
// RefundRecordItem's shape (variant-level quantity, not just a dollar
// amount) so an approved request can hand its exact items straight to the
// existing partial-refund restock logic.
model ReturnRequestItem {
  id              Int           @id @default(autoincrement())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnRequestId Int
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId     Int
  quantity        Int

  @@index([returnRequestId])
  @@index([orderItemId])
}

// One row per status transition — Order.updatedAt only ever reflects the
// MOST RECENT change, so once an order has gone PENDING -> PAID -> SHIPPED,
// there's no other way to answer "when was this paid?" once it's shipped.
// This table is the real timeline shown on the order detail page.
model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  status    OrderStatus
  changedAt DateTime    @default(now())

  @@index([orderId])
}

model OrderItem {
  id             Int            @id @default(autoincrement())
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        Int
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  variantId      Int
  quantity       Int
  unitPriceCents Int

  refundItems        RefundRecordItem[]
  returnRequestItems ReturnRequestItem[]

  @@index([orderId])
  @@index([variantId])
}

// ── Payments ───────────────────────────────────────────────────────────

// Webhook replay protection — no Redis in this stack, so processed Stripe
// event IDs are recorded here instead. A webhook whose event.id already
// exists is ignored rather than reprocessed, since Stripe can and does
// redeliver the same event.
model ProcessedWebhookEvent {
  id          String   @id // Stripe event.id
  type        String
  processedAt DateTime @default(now())
}

// ── Notifications ──────────────────────────────────────────────────────

// What condition raised this notification — used both to render an icon/
// label and to de-duplicate (see notification.service.ts): the same
// underlying thing (e.g. this order still being PENDING, this variant still
// being low) should only ever produce one open notification, not a fresh
// one on every check.
enum NotificationType {
  RETURN_REQUEST_PENDING
  LOW_STOCK
  ORDER_STALE
  // Reviews publish immediately (no pending state — see
  // review.service.ts's logReview), so there's no REVIEW_PENDING type;
  // only questions have an unanswered state worth alerting on.
  QUESTION_PENDING
}

// A real, persistent inbox entry — distinct from just querying "is there a
// pending return request right now," because isRead and resolvedAt track
// state independently of the underlying condition. An admin can read a
// low-stock alert without having restocked yet (isRead: true, resolvedAt:
// null), and the condition being fixed later (restocked, request reviewed,
// order progressed) sets resolvedAt without requiring the admin to have
// read it first — the two are tracked separately on purpose, matching "read
// vs addressed/fixed" being two different questions.
model Notification {
  id    Int              @id @default(autoincrement())
  type  NotificationType
  title String
  body  String           @db.Text
  // Where clicking this notification should take an admin — an order or
  // inventory page path, e.g. "/orders/123" or "/inventory". Plain string
  // rather than a polymorphic relation since notifications point at
  // different kinds of things (orders, variants).
  link  String

  // De-duplication key: one open (unresolved) notification per (type,
  // dedupeKey) — e.g. `return-request-42` or `variant-17-low-stock` — so
  // the same event-driven hook firing again (a second partial refund
  // request review, another sale drawing an already-low variant further
  // down) doesn't spam a fresh row every time.
  dedupeKey String

  isRead     Boolean   @default(false)
  // Set once the underlying condition is no longer true (request resolved,
  // stock back above threshold, order progressed past PENDING/SHIPPED) —
  // independent of isRead, see model comment above.
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([resolvedAt])
  @@index([dedupeKey])
}

// ── Reviews & Q&A ──────────────────────────────────────────────────────

// Reviews publish immediately — no pending/approve gate. A pre-publish
// moderation queue risks an admin selectively waving through only good
// reviews, which is a worse trust problem than the one moderation is meant
// to solve (see review.service.ts's logReview). Bad-faith/spam reviews are
// handled after the fact via a hard delete instead, so there's no status
// to track here — a Review row existing at all means it's live.
model Review {
  id         Int      @id @default(autoincrement())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  Int
  // A review requires an actual purchase (see review.service.ts's
  // logReview — verified against a PAID/SHIPPED/DELIVERED order containing
  // this product before the row is even created), so unlike ReturnRequest
  // this IS a hard FK to the purchasing customer, not just a name snapshot.
  // onDelete: SetNull rather than Cascade — a review shouldn't vanish just
  // because the underlying account was removed later; authorName (below)
  // keeps it legible either way.
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     Int?
  // Snapshot of the purchasing customer's email at review time — same
  // "plain string alongside the FK" pattern as OrderNote.authorName, so the
  // review still reads correctly even if the User row is later removed.
  authorName String
  rating     Int // 1-5, validated at the service layer (Prisma has no CHECK constraint on MySQL here).
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

// A customer question about a product, answered publicly by staff — kept
// separate from Review (a rating + opinion) since a question has no rating
// and its "resolution" is an answer being written, not an approve/reject
// decision. A question with answeredAt: null is what's waiting in the
// admin's Q&A queue.
model ProductQuestion {
  id             Int       @id @default(autoincrement())
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      Int
  // Optional, unlike Review.userId — asking a question doesn't require a
  // purchase (see review.service.ts's logQuestion), so this stays nullable
  // for a question logged for a browsing/prospective customer who has no
  // User row yet. Same onDelete: SetNull reasoning as Review.
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         Int?
  authorName     String
  question       String    @db.Text
  answer         String?   @db.Text
  answeredByName String?
  answeredAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([productId])
  @@index([answeredAt])
  @@index([userId])
}

// ── Cart leads ─────────────────────────────────────────────────────────

// There's no storefront/live customer session in this system (see
// checkout() — an order is created directly from a cart array passed at
// checkout time, with nothing persisted before that). So this isn't a real
// transactional cart — it's a staff-logged record of items a customer said
// they were interested in but hadn't bought yet (phone/chat inquiry), same
// "logged on the customer's behalf" pattern as ReturnRequest/Review. Lets
// admin follow up on a lead without needing a real add-to-cart flow to
// exist first.
model CartLead {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  loggedByName String
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  items CartLeadItem[]

  @@index([userId])
}

model CartLeadItem {
  id         Int            @id @default(autoincrement())
  cartLead   CartLead       @relation(fields: [cartLeadId], references: [id], onDelete: Cascade)
  cartLeadId Int
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId  Int
  quantity   Int

  @@index([cartLeadId])
  @@index([variantId])
}

// ── Store settings ─────────────────────────────────────────────────────

// Which credential pair (see StoreSettings below) is actually live —
// SANDBOX uses the *Test fields (and falls back to .env), PRODUCTION uses
// the *Live fields. See lib/credentials.ts.
enum ApiEnvironment {
  SANDBOX
  PRODUCTION
}

// Singleton row (always id: 1) for store-wide admin-configurable values —
// the Configuration page reads/writes this. Starts with just the store
// name (shown in the Sidebar instead of a hardcoded string); add more
// columns here as Configuration grows rather than one-off hardcoded values
// elsewhere in the UI.
model StoreSettings {
  id                  Int     @id @default(1)
  storeName           String  @default("Sawo Shop")
  // Null means "no logo uploaded" — the Sidebar falls back to a plain
  // initial-letter box in that case rather than a broken image.
  logoUrl             String?
  // Off by default — partial refunds leave an order in an in-between
  // PARTIALLY_REFUNDED state with specific items/quantities held out of
  // inventory, which is a real operational mode staff need to opt into
  // rather than have silently available. See payment.service.ts refundOrder.
  allowPartialRefunds Boolean @default(false)
  // Used when an order's shippingCountry has no matching CarrierRule.
  defaultCarrier      String  @default("USPS")

  // Which pair of credentials below is actually used to build the
  // Stripe/EasyPost clients — see lib/credentials.ts. SANDBOX by default so
  // a fresh install never accidentally fires a real charge/shipment before
  // someone deliberately flips this.
  apiEnvironment ApiEnvironment @default(SANDBOX)

  // Test AND live credentials for external integrations, editable from
  // Configuration instead of the server's .env file — see
  // lib/credentials.ts, which picks the pair matching apiEnvironment and
  // falls back to .env (as the SANDBOX value) so an existing deployment
  // configured only via .env keeps working unchanged. Stored as plain text:
  // ADMIN-only write (see settings.routes.ts) is this table's only access
  // control, same trust boundary as the rest of it — this is a backoffice
  // tool, not a secrets vault.
  stripeSecretKeyTest     String? @db.Text
  stripeWebhookSecretTest String? @db.Text
  easypostApiKeyTest      String? @db.Text
  stripeSecretKeyLive     String? @db.Text
  stripeWebhookSecretLive String? @db.Text
  easypostApiKeyLive      String? @db.Text

  updatedAt DateTime @updatedAt
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

// Admin-managed discount codes applied at checkout (see pricing.service.ts's
// priceCart and order.service.ts's checkout). code is the natural key
// customers type in - stored uppercase so lookups are case-insensitive
// without a DB-level collation dependency (see coupon.service.ts).
model Coupon {
  id    Int        @id @default(autoincrement())
  code  String     @unique
  type  CouponType
  // Meaning depends on type: PERCENTAGE -> 1-100 (percent off subtotal),
  // FIXED_AMOUNT -> cents off subtotal, FREE_SHIPPING -> always null (there's
  // no numeric value to apply; shippingCents is zeroed directly instead of
  // treated as a discount amount, see priceCart).
  value Int?

  // Same null-window convention as Product.saleStartsAt/saleEndsAt: both
  // null means the coupon is active indefinitely (as long as isActive is
  // true); a set window is checked at read time, no cron required.
  startsAt DateTime?
  endsAt   DateTime?

  // Manual on/off switch independent of the date window - lets an admin
  // kill a coupon immediately without needing to know/edit its window.
  isActive Boolean @default(true)

  // Null = unlimited. Enforced against usageCount at checkout time inside a
  // transaction (see order.service.ts's checkout) so a burst of concurrent
  // checkouts can't overrun the cap.
  maxUses    Int?
  usageCount Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive])
}

// Country -> carrier assignment rules, editable from Configuration. Checked
// in insertion order the first time a country has no matching rule falls
// back to defaultCarrier below — see shipping.service.ts's assignCarrier.
model CarrierRule {
  id      Int    @id @default(autoincrement())
  country String @unique // ISO 3166-1 alpha-2, e.g. "US"
  carrier String // e.g. "UPS", "DHL", "FedEx", "USPS"
}

// Country -> accepted payment method rules, editable from Configuration.
// One row per (country, method) pair rather than a joined string so
// "is CARD allowed in DE" is a plain indexed lookup. A country with NO rows
// here has no restriction — every PaymentMethod is accepted — matching how
// this store behaves today before any rule is ever added (see
// paymentMethodRule.service.ts's isPaymentMethodAllowed).
model PaymentMethodRule {
  id            Int           @id @default(autoincrement())
  country       String // ISO 3166-1 alpha-2, e.g. "US"
  paymentMethod PaymentMethod

  @@unique([country, paymentMethod])
  @@index([country])
}

// Country -> flat sales-tax rate, editable from Configuration. A real tax
// engine (TaxJar/Avalara — jurisdiction-specific rates, nexus rules, product
// tax categories) is out of scope, same reasoning pricing.service.ts's old
// comment gave for stubbing tax at 0: no such API account exists yet. This
// is the same shape as CarrierRule/PaymentMethodRule instead — a flat
// per-country rate an admin sets by hand, applied to the discounted
// subtotal at checkout (see pricing.service.ts's priceCart). A country with
// no row here has no tax, matching PaymentMethodRule's "absence means no
// restriction" default rather than erroring or assuming some rate.
model TaxRule {
  id            Int    @id @default(autoincrement())
  country       String @unique // ISO 3166-1 alpha-2, e.g. "US"
  // Percent, not basis points — e.g. 8.5 means 8.5%. Decimal for the cents
  // math in priceCart to stay exact enough for real-world rates like
  // Canada's 5% GST + 7.5% QST combined as one 12.5% row (this app has no
  // multi-line tax breakdown, just one effective rate per country).
  ratePercent Decimal @db.Decimal(5, 2)
}
